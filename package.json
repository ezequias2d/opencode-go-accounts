{
  "name": "@ezequias2d/opencode-go-accounts",
  "version": "0.1.0",
  "description": "Switch between multiple opencode-go accounts from the opencode TUI.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/server.js",
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "opencode": "^1.18.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-go",
    "plugin",
    "accounts"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opencode-ai/sdk": "1.18.31",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^22.13.9",
    "solid-js": "1.9.15",
    "tsup": "^8.3.6",
    "typescript": "^5.8.2"
  }
}
